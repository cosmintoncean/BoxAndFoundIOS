// Copy to Secrets.xcconfig and fill in. Secrets.xcconfig is gitignored.
//
// SUPABASE_URL and SUPABASE_ANON_KEY come from Supabase -> Project Settings ->
// API, and are the same values the web client's .env and the Android
// secrets.properties use. The anon key is safe in a shipped client; row-level
// security is what protects the data.
//
// !! xcconfig treats // as a comment, everywhere, including mid-value. A URL
// written literally would be truncated to "https:". SLASH is the standard
// workaround and must stay.
SLASH = /

SUPABASE_URL = https:$(SLASH)$(SLASH)YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = your-anon-key

// Comma-separated allowlist granted premium regardless of user_metadata.
// Mirrors PREMIUM_EMAILS in the web client and on Android. May be empty.
PREMIUM_EMAILS =
